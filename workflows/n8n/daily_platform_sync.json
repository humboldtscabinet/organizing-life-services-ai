{
  "name": "Daily Platform Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "trigger-daily",
      "name": "Every day 06:00 ET",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/api/dashboard/refresh",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{$env.OLS_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "refresh-data",
      "name": "POST /api/dashboard/refresh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "status-ok",
              "leftValue": "={{$json.status}}",
              "rightValue": "success",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-success",
      "name": "Refresh succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/api/dashboard/alerts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"source\": \"n8n_daily_platform_sync\",\n  \"severity\": \"INFO\",\n  \"title\": \"Daily platform sync completed\",\n  \"message\": \"GSC, GA4, and Ads data refreshed and tasks generated.\",\n  \"fingerprint\": \"n8n-daily-platform-sync\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{$env.OLS_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        }
      },
      "id": "alert-success",
      "name": "Alert success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/api/dashboard/alerts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"source\": \"n8n_daily_platform_sync\",\n  \"severity\": \"WARNING\",\n  \"title\": \"Daily platform sync needs follow-up\",\n  \"message\": \"One or more pull/push steps failed. Review /api/dashboard/refresh output.\",\n  \"fingerprint\": \"n8n-daily-platform-sync\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{$env.OLS_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        }
      },
      "id": "alert-partial",
      "name": "Alert partial failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 380]
    }
  ],
  "connections": {
    "Every day 06:00 ET": {
      "main": [[{ "node": "POST /api/dashboard/refresh", "type": "main", "index": 0 }]]
    },
    "POST /api/dashboard/refresh": {
      "main": [[{ "node": "Refresh succeeded?", "type": "main", "index": 0 }]]
    },
    "Refresh succeeded?": {
      "main": [
        [{ "node": "Alert success", "type": "main", "index": 0 }],
        [{ "node": "Alert partial failure", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
